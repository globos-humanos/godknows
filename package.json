{
  "name": "recallpg",
  "version": "1.0.0",
  "description": "NEET-PG 2026 AI Study Companion",
  "scripts": {
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "install:worker": "cd worker && pip install -r requirements.txt",
    "install:all": "npm run install:client && npm run install:server",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:worker": "cd worker && uvicorn app:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\""
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.10",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.14",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.1"
  }
}
